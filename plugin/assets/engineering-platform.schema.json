{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CEP Project Integration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "packs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      }
    },
    "pack_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      }
    },
    "autonomy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auto_merge": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
